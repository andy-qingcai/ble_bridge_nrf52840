/*
 * blebridge bridge — bring-up 变体: 用户自定义 UART 引脚 @ 115200 8N1 + RTS/CTS。
 *
 * 与 nrf52840dk_nrf52840_uart_custom.overlay（产品速率 921600, FR-A5）唯一的
 * 差别是 current-speed = <115200>。存在理由（2026-09-25 bring-up 实测）:
 * 当前唯一 host 通路是 WCH-Link 的 CDC UART 桥,其 921600 RX 方向对 >64 B
 * 长突发不可靠（字节丢失/乱序, ≤64 B 帧始终完好）,长帧 CRC 无法通过;
 * 115200 下长帧 CRC 全部通过。待 host 通路更换或桥固件验证 921600 后,
 * 产品配置仍回到 921600 overlay。
 *
 * 引脚与偏置逐字沿用产品 overlay:
 *   TX=P1.04 (pull 无)  RX=P1.13 (pull-up)
 *   RTS=P1.15           CTS=P1.00 (pull-down, 悬空=允许发送)
 *
 * 使用（独立 build 目录, 不污染产品构建）:
 *   west build -p -b nrf52840dk/nrf52840 <app> -d <scratch> -- \
 *       '-DCONFIG_BRIDGE_PHY="uart0"' \
 *       -DEXTRA_DTC_OVERLAY_FILE=<repo>/firmware/app/boards/nrf52840dk_nrf52840_uart_custom_115200.overlay \
 *       -DEXTRA_CONF_FILE=<repo>/firmware/app/debug_rtt.conf
 * 烧录: pyocd flash -e sector -t nrf52840 -f 1000000 <hex>（WCH-Link 限 1MHz SWD）
 * host: SerialTransport(baudrate=115200, rtscts=False)（macOS CDC 上
 *       rtscts=True 会静默扣发 write; 开端口首帧会被桥毛刺打坏,需重试）
 */

&pinctrl {
	uart0_default_alt: uart0_default_alt {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RTS, 1, 15)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 13)>;
			bias-pull-up;
		};

		group3 {
			psels = <NRF_PSEL(UART_CTS, 1, 0)>;
			bias-pull-down;
		};
	};

	uart0_sleep_alt: uart0_sleep_alt {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 13)>,
				<NRF_PSEL(UART_RTS, 1, 15)>,
				<NRF_PSEL(UART_CTS, 1, 0)>;
			low-power-enable;
		};
	};
};

&uart0 {
	pinctrl-0 = <&uart0_default_alt>;
	pinctrl-1 = <&uart0_sleep_alt>;
	pinctrl-names = "default", "sleep";
	hw-flow-control;
	current-speed = <115200>;
};
